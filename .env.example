# Salin menjadi .env.local untuk menjalankan di laptop (npm run dev).
# Di GitHub, isi nilai yang sama di Settings → Secrets and variables → Actions → Variables.
# Nilai Firebase ini memang boleh terlihat publik; keamanan dijaga oleh firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=nama-proyek.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nama-proyek
VITE_FIREBASE_APP_ID=
# URL Web App Apps Script (berakhiran /exec) untuk unggah berkas & kelola akun
VITE_GAS_URL=
# Domain untuk akun berbasis NIS. Pengguna cukup mengetik "2023045", sistem memakai 2023045@<domain ini>.
VITE_LOGIN_DOMAIN=simma.miftahulumul.id
# Isi "true" hanya saat uji lokal dengan Firebase Emulator (npm run emulator)
VITE_USE_EMULATOR=false

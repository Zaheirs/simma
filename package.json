{
  "name": "simma",
  "private": true,
  "version": "1.0.1",
  "description": "SIMMA — Sistem Informasi Manajemen Madrasah MI. Miftahul Ulum Semampir (Tahap 1: fondasi, dashboard, data induk)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "emulator": "npx firebase-tools@14 emulators:start --only auth,firestore",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "test:rules": "npx firebase-tools@14 emulators:exec --only firestore \"vitest run tests/rules.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "firebase": "^11.10.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
